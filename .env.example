# Template only: npm scripts do not automatically read this file.
# Set variables in your shell, or pass a copy to Docker with --env-file .env.

HOST=127.0.0.1
PORT=8787
DATA_DIR=data
MAX_FILE_SIZE_MB=500
MAX_FILES=30
RENDER_CONCURRENCY=2
RETENTION_HOURS=24

# For Docker, change HOST to 0.0.0.0 and DATA_DIR to /app/data.
# Keep the published Docker port on 127.0.0.1 for private local access.
