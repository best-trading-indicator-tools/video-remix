# Template: put real values in .env, which the backend loads automatically.
# Explicit shell variables take precedence; Docker also supports --env-file .env.

HOST=127.0.0.1
PORT=8787
DATA_DIR=data
MAX_FILE_SIZE_MB=500
# Resumable source imports, separate from the B-roll/multipart limit above.
MAX_LARGE_FILE_SIZE_GB=50
# Per selection and unfinished import queue; completed imports do not use slots.
MAX_FILES=100
# Optional custom yt-dlp executable. Otherwise uses setup:imports, .venv, or PATH.
# YT_DLP_BIN=/absolute/path/to/yt-dlp
# Optional exported Netscape-format cookies for links requiring login.
# Otherwise checks cookies.txt in the project folder, then DATA_DIR/cookies.txt.
# No cookie file is needed when public downloads already work.
# YT_DLP_COOKIES=C:/Users/YourName/Downloads/cookies.txt
RENDER_CONCURRENCY=2
# Additional attempts after a failed/interrupted render (0 disables retries).
RENDER_MAX_RETRIES=3
# Backoff triples after each failure, capped at five minutes.
RENDER_RETRY_DELAY_SECONDS=5
RETENTION_HOURS=24

# Speech recognition stays local after npm run setup:auto downloads the model.
WHISPER_MODEL=small
# Defaults to DATA_DIR/models; uncomment only to use a different cache.
# WHISPER_CACHE_DIR=/absolute/path/to/speech-models

# Optional local planning. Install Ollama and run: ollama pull llama3.2
AUTO_LOCAL_AI=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional: use an installed Chromium instead of Puppeteer's bundled browser.
# Local HyperFrames cards need no API key.
# PRODUCER_HEADLESS_SHELL_PATH=/usr/bin/chromium

# Optional existing stock videos. Used only when Stock B-roll is selected.
# Get a free key at https://pixabay.com/api/docs/ and set it privately.
# PIXABAY_API_KEY=

# Optional paid AI B-roll matching. Only used when AI matching is selected.
# Sends short transcript context for semantic stock searches and sampled
# B-roll frames for relevance checks to DeepSeek. Motion checks remain local.
# Set your own API key privately; never commit it or use a VITE_ variable.
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional separate text model; defaults to DEEPSEEK_MODEL.
# DEEPSEEK_TEXT_MODEL=deepseek-flash
# Low thinking effort for clip selection, semantic B-roll matching and editorial review.
# Prompt edits, stock queries, visual descriptions and packaging stay in fast mode.
# Set false and restart to compare with the previous all-fast behavior.
DEEPSEEK_THINKING=true

# For Docker, change HOST to 0.0.0.0 and DATA_DIR to /app/data.
# Keep the published Docker port on 127.0.0.1 for private local access.
# Container Ollama connections need a service address reachable from the container.

# Finished picture review uses an image-capable model independently of text editing.
# Sampled source/export JPEGs and recognized speech are sent to this model.
# Audio transcription stays local; disable automatic finished review per video in Auto.
# DEEPSEEK_VISION_MODEL=deepseek-flash
